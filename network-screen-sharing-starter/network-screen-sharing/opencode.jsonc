// Project config for opencode. Permission rules: the LAST matching rule wins, so broad rules come first.
// Shape verified against the opencode permissions documentation. Windows/PowerShell command patterns: untested.
{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Safe, routine commands
    { "action": "shell", "resource": "python -m unittest *", "effect": "allow" },
    { "action": "shell", "resource": "python -m py_compile *", "effect": "allow" },
    { "action": "shell", "resource": "python demo/transport_demos.py boundaries", "effect": "allow" },
    { "action": "shell", "resource": "python demo/transport_demos.py ports", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },

    // Never without the student doing it by hand
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
    { "action": "shell", "resource": "del *", "effect": "deny" },

    // The specification is read-only for the agent
    { "action": "edit", "resource": "ARCHITECTURE.md", "effect": "deny" },

    // Provided, tested code: ask before changing it
    { "action": "edit", "resource": "protocol.py", "effect": "ask" },
    { "action": "edit", "resource": "latest_slot.py", "effect": "ask" },
    { "action": "edit", "resource": "outbox.py", "effect": "ask" },
    { "action": "edit", "resource": "keymap.py", "effect": "ask" },
    { "action": "edit", "resource": "geometry.py", "effect": "ask" },
    { "action": "edit", "resource": "demo/transport_demos.py", "effect": "deny" }
  ]
}
